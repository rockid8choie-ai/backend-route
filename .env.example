# App (transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma migrate / db push (session or direct, port 5432)
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# 인증(JWT) 서명 키 — 충분히 긴 랜덤 문자열
JWT_SECRET="replace-with-long-random-string"

# OpenAI API 키 — /ai/classify (민원 AI 분류). 없으면 503으로 안내되고 수동 입력으로 폴백
OPENAI_API_KEY="sk-..."

# CORS 허용 프론트엔드 주소
FRONTEND_URL="https://bfs-mission6.vercel.app"
