generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String? // bcrypt 해시 — 기존(미션 7) 행은 비밀번호가 없어 로그인 불가
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  files     File[]
  works     Work[]
}

model Work {
  id        Int       @id @default(autoincrement())
  title     String
  category  String
  location  String
  priority  String    @default("보통")
  status    String    @default("접수")
  desc      String    @default("")
  fastTrack Boolean   @default(false) // 우선처리 결제 완료 여부
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments  Payment[]
}

// 우선처리 결제 — 토스페이먼츠. 금액은 서버가 확정하고 승인 시 대조한다.
model Payment {
  id         Int       @id @default(autoincrement())
  orderId    String    @unique
  amount     Int
  status     String    @default("pending") // pending | paid | failed
  paymentKey String?
  method     String?
  receiptUrl String?
  failReason String?
  createdAt  DateTime  @default(now())
  approvedAt DateTime?
  userId     Int
  workId     Int
  work       Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
}

model File {
  id           Int      @id @default(autoincrement())
  originalName String
  storedName   String   @unique
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
}
